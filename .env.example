# ============================================================
#  Fruteira — configuração de ambiente (copie para .env)
#  Não use aspas nem espaços ao redor do "=".
# ============================================================
# desenvolvimento -> login local (usuário = senha = perfil), banco H2 (./iniciar.sh)
# producao        -> login via Keycloak (OIDC), PostgreSQL; roda pela pasta producao/ com SÓ Java 21 + PostgreSQL na máquina (sem Docker/Node/Maven)
APP_ENV=desenvolvimento

# ---------------- só em producao ----------------
# URLs públicas, sem barra no final: o endereço que os caixas digitam no navegador (use o IP/nome do servidor na rede da loja).
# Mudou? Basta editar e reiniciar: o front lê a URL do Keycloak daqui na hora (não precisa recompilar). Se mudar FRONT_URL
# depois da 1ª subida, ajuste também o cliente "pdv-web" (Redirect URIs) no console do Keycloak: o realm só é importado uma vez.
KEYCLOAK_URL=http://localhost:8180
FRONT_URL=http://localhost:5173
# Portas do Keycloak e do servidor web do front
#KEYCLOAK_PORT=8180
#WEB_PORT=5173
# HTTPS opcional sem nginx: keystore PKCS12 (.p12) do seu certificado. O Keycloak e o front precisam dele juntos
# (KEYCLOAK_URL=https://... e FRONT_URL=https://...). Sem isto tudo roda em HTTP (rede interna da loja).
#WEB_TLS_P12=/caminho/site.p12
#WEB_TLS_SENHA=
#KEYCLOAK_TLS_P12=/caminho/site.p12
#KEYCLOAK_TLS_SENHA=

KEYCLOAK_REALM=fruteira
KEYCLOAK_WEB_CLIENT=pdv-web
KEYCLOAK_API_CLIENT=fruteira-api
KEYCLOAK_ADMIN=admin
KEYCLOAK_ADMIN_PASSWORD=troque-esta-senha
KEYCLOAK_DB_PASS=troque-esta-senha-tambem
# Memória do Keycloak e dos serviços Java (padrões: -Xms128m -Xmx512m e -Xmx384m por serviço)
#KEYCLOAK_JAVA_OPTS=-Xms128m -Xmx512m
#JAVA_OPTS=-Xmx384m

# Validação do certificado do Keycloak pelos serviços Java: required | none (só teste com certificado autoassinado)
OIDC_TLS_VERIFICATION=required

# PostgreSQL INSTALADO na máquina (14 ou mais novo, com o serviço iniciado). O iniciar cria sozinho o banco e o usuário da
# aplicação (DB_USER/DB_PASS) e o banco/usuário do Keycloak, usando o administrador abaixo.
DB_URL=jdbc:postgresql://localhost:5432/fruteira
DB_USER=fruteira
DB_PASS=troque-a-senha-do-banco
# Administrador do PostgreSQL (o "postgres" definido na instalação). Só é usado para criar/ajustar bancos e usuários.
PG_ADMIN_USER=postgres
PG_ADMIN_PASS=
# Pasta bin do PostgreSQL, só se o psql/pg_dump não forem achados sozinhos (ex.: C:\Program Files\PostgreSQL\16\bin)
#PG_BIN=
# Banco de dados: o schema é criado/atualizado pelo FLYWAY, que roda só no retaguarda-service (db/migration, dono das migrations dos 4 serviços). Os demais só conferem (validate).
# DB_SCHEMA_MODE=update      -> contorno de EMERGÊNCIA: deixa o Hibernate ajustar o schema sozinho (não use em produção)
# H2_ARQUIVO=../data/fruteira  -> (só desenvolvimento) arquivo H2 compartilhado pelos 4 serviços
# FLYWAY_LOCATIONS=db/migration   -> produção SEM o pré-cadastro de frutas e verduras (padrão: db/migration,db/pre-cadastro)

# ---------------- Backup (comando "backup" da produção) ----------------
# Pasta local (padrão: backups), cópias extras separadas por ponto e vírgula (pendrive, Google Drive do computador), senha AES-256,
# retenção em dias e, se tiver o rclone, o destino do Google Drive. Leia o LEIA-ME.txt da pasta producao.
#BACKUP_PASTA=backups
#BACKUP_DESTINOS=E:\fruteira;G:\Meu Drive\Fruteira
#BACKUP_SENHA=
BACKUP_RETENCAO_DIAS=30
#RCLONE_DESTINO=gdrive:Fruteira/backup

# ---------------- TEF (agente local do caixa) ----------------
# simulador = NÃO cobra de verdade (testes). clisitef = a implementar com a DLL do seu provedor (ver tef-agent).
TEF_PROVIDER=simulador
# Token que o caixa envia ao agente; use o mesmo em Configurações → Balança e periféricos. Em produção, um valor longo e secreto.
#TEF_TOKEN=troque-por-um-token-longo
# Origens permitidas (CORS) para chamar o agente; por padrão usa FRONT_URL
#TEF_ORIGENS=https://loja.seudominio.com.br
# ---------------- Saúde dos pagamentos (rotina agendada no vendas-service) ----------------
# De quanto em quanto tempo conferir se o Pix (PIX_PROVIDER) e o TEF (TEF_PROVIDER) estão funcionando: 1h, 30m, 15m, 2h... ("off" desliga)
# Só o Pix e o TEF DEFINIDOS são conferidos: com TEF_PROVIDER vazio ou "nenhum" o TEF não entra na verificação.
SAUDE_INTERVALO=1h
# Atraso da 1ª verificação depois que o serviço inicia
#SAUDE_PRIMEIRA_EM=1m
# Onde está o agente TEF visto pelo vendas-service (só mude se ele roda em outro computador) e quantas verificações guardar na tela
#SAUDE_TEF_URL=http://127.0.0.1:8090
#SAUDE_HISTORICO=48

# Exigir TEF para crédito/débito (variável lida pelo vendas-service): true | false
#FRUTEIRA_TEF_OBRIGATORIO=false

# Ao iniciar, encerra o que estiver escutando nas portas do sistema (8081-8084, 8090, 5173): sobra de execução anterior. false = não mexer.
#LIBERAR_PORTAS=true

# ---------------- PIX ----------------
# PIX_PROVIDER: SIMULADOR (NÃO é Pix real, testes) | EFI | ITAU | BRADESCO | SICOOB | SICREDI | MERCADO_PAGO | ASAAS. Ver README.
PIX_PROVIDER=simulador
#PIX_CHAVE=sua-chave-pix-cadastrada-no-provedor   # vale para todos; PIX_<BANCO>_CHAVE sobrescreve num banco específico
#PIX_NOME=FRUTEIRA CONVENTOS
#PIX_CIDADE=SUA CIDADE
#PIX_EXPIRACAO_SEG=300
# Webhook (PÚBLICO): segredo conferido pelo servidor e URL registrada no provedor (botão em Configurações → Balança e periféricos → PIX)
#FRUTEIRA_PIX_WEBHOOK_SEGREDO=troque-por-um-segredo-longo
#FRUTEIRA_PIX_WEBHOOK_URL=https://loja.seudominio.com.br/api/vendas/pix/webhook?token=troque-por-um-segredo-longo
# --- Ngrok (testes do Pix real sem domínio/servidor público) --- A URL do webhook passa a ser {túnel}/pix/webhook?token={segredo}.
# Ordem: FRUTEIRA_PIX_WEBHOOK_URL (se preenchida, vence) > NGROK_URL > túnel descoberto sozinho na API local do Ngrok (4040).
# USAR_NGROK=true  -> iniciar.sh/.bat abrem `ngrok http 8083` e passam o endereço ao vendas-service (precisa do ngrok instalado + authtoken:
#                     `ngrok config add-authtoken ...` ou NGROK_AUTHTOKEN abaixo). Sem isto, abra você mesmo: ngrok http 8083
# O túnel aponta DIRETO para o vendas-service (8083); por ele só o POST /pix/webhook responde (o resto da API fica fechado). Não aponte para o front (5173).
# No plano grátis o endereço muda a cada início: clique em "Registrar webhook" (gerente) de novo, ou use PIX_WEBHOOK_AUTO_REGISTRAR=true.
#USAR_NGROK=false
#NGROK_AUTHTOKEN=
#NGROK_DOMINIO=seu-nome.ngrok-free.app     # domínio reservado (fixo): vira ngrok http 8083 --url=...
#NGROK_URL=https://seu-nome.ngrok-free.app # só se você abrir o ngrok por fora e quiser fixar o endereço (vazio = descobre sozinho)
#NGROK_ARGS=                               # argumentos extras do ngrok (ex.: --region sa)
#NGROK_CAMINHO=/pix/webhook                # túnel pelo front: /api/vendas/pix/webhook
#PIX_WEBHOOK_AUTO_REGISTRAR=false          # true = registra a URL no provedor a cada subida (SOBRESCREVE o webhook da conta: não use com a conta de produção)
# Credenciais — ficam SÓ no servidor. Preencha apenas o bloco do provedor escolhido. Vazio = padrão do provedor.

# --- Efí (PIX_PROVIDER=EFI) ---
#PIX_EFI_URL=
#PIX_EFI_TOKEN_URL=
#PIX_EFI_CLIENT_ID=
#PIX_EFI_CLIENT_SECRET=
#PIX_EFI_TOKEN_FORMATO=
#PIX_EFI_ESCOPOS=
#PIX_EFI_CABECALHOS=
#PIX_EFI_PREFIXO_API=
#PIX_EFI_CAMINHO_COB=
#PIX_EFI_CHAVE=
#PIX_EFI_CERTIFICADO=/caminho/certificado.p12
#PIX_EFI_CERTIFICADO_SENHA=
#PIX_EFI_SKIP_MTLS_WEBHOOK=false
# URL e token já têm padrão (sandbox: https://pix-h.api.efipay.com.br). TOKEN_FORMATO=basic-json. Para registrar o webhook sem mTLS: SKIP_MTLS_WEBHOOK=true

# --- Itaú (PIX_PROVIDER=ITAU) ---
#PIX_ITAU_URL=
#PIX_ITAU_TOKEN_URL=
#PIX_ITAU_CLIENT_ID=
#PIX_ITAU_CLIENT_SECRET=
#PIX_ITAU_TOKEN_FORMATO=
#PIX_ITAU_ESCOPOS=
#PIX_ITAU_CABECALHOS=
#PIX_ITAU_PREFIXO_API=
#PIX_ITAU_CAMINHO_COB=
#PIX_ITAU_CHAVE=
#PIX_ITAU_CERTIFICADO=/caminho/certificado.p12
#PIX_ITAU_CERTIFICADO_SENHA=
#PIX_ITAU_SKIP_MTLS_WEBHOOK=false
# Informe a URL da API Pix do Itaú (documentação do banco). Token: sts.itau.com.br (padrão). TOKEN_FORMATO=form. Chave de API/IDs extras: CABECALHOS=Nome=valor;Outro=valor

# --- Bradesco (PIX_PROVIDER=BRADESCO) ---
#PIX_BRADESCO_URL=
#PIX_BRADESCO_TOKEN_URL=
#PIX_BRADESCO_CLIENT_ID=
#PIX_BRADESCO_CLIENT_SECRET=
#PIX_BRADESCO_TOKEN_FORMATO=
#PIX_BRADESCO_ESCOPOS=
#PIX_BRADESCO_CABECALHOS=
#PIX_BRADESCO_PREFIXO_API=
#PIX_BRADESCO_CAMINHO_COB=
#PIX_BRADESCO_CHAVE=
#PIX_BRADESCO_CERTIFICADO=/caminho/certificado.p12
#PIX_BRADESCO_CERTIFICADO_SENHA=
#PIX_BRADESCO_SKIP_MTLS_WEBHOOK=false
# URL e token já têm padrão. TOKEN_FORMATO=basic-form. Se o banco exigir cobrança com EMV: CAMINHO_COB=/cob-emv. O Bradesco entrega certificado em .pem + .key: converta para .p12 (README).

# --- Sicoob (PIX_PROVIDER=SICOOB) ---
#PIX_SICOOB_URL=
#PIX_SICOOB_TOKEN_URL=
#PIX_SICOOB_CLIENT_ID=
#PIX_SICOOB_CLIENT_SECRET=
#PIX_SICOOB_TOKEN_FORMATO=
#PIX_SICOOB_ESCOPOS=
#PIX_SICOOB_CABECALHOS=
#PIX_SICOOB_PREFIXO_API=
#PIX_SICOOB_CAMINHO_COB=
#PIX_SICOOB_CHAVE=
#PIX_SICOOB_CERTIFICADO=/caminho/certificado.p12
#PIX_SICOOB_CERTIFICADO_SENHA=
#PIX_SICOOB_SKIP_MTLS_WEBHOOK=false
# URL e token já têm padrão. O CLIENT_ID também vai no cabeçalho client_id (automático). TOKEN_FORMATO=form.

# --- Sicredi (PIX_PROVIDER=SICREDI) ---
#PIX_SICREDI_URL=
#PIX_SICREDI_TOKEN_URL=
#PIX_SICREDI_CLIENT_ID=
#PIX_SICREDI_CLIENT_SECRET=
#PIX_SICREDI_TOKEN_FORMATO=
#PIX_SICREDI_ESCOPOS=
#PIX_SICREDI_CABECALHOS=
#PIX_SICREDI_PREFIXO_API=
#PIX_SICREDI_CAMINHO_COB=
#PIX_SICREDI_CHAVE=
#PIX_SICREDI_CERTIFICADO=/caminho/certificado.p12
#PIX_SICREDI_CERTIFICADO_SENHA=
#PIX_SICREDI_SKIP_MTLS_WEBHOOK=false
# URL padrão de produção (sandbox: https://api-pix-h.sicredi.com.br). TOKEN_FORMATO=basic-form.

# --- Mercado Pago (PIX_PROVIDER=MERCADO_PAGO) --- API própria; use as credenciais de TESTE antes das de produção
#PIX_MERCADO_PAGO_URL=https://api.mercadopago.com
#PIX_MERCADO_PAGO_ACCESS_TOKEN=
#PIX_MERCADO_PAGO_EMAIL_PAGADOR=loja@seudominio.com.br
#PIX_MERCADO_PAGO_CPF_PAGADOR=
# O Pix do Mercado Pago dura no mínimo 30 min; o caixa expira antes (PIX_EXPIRACAO_SEG) e cancela a cobrança. Exige FRUTEIRA_PIX_WEBHOOK_URL ou o Ngrok (USAR_NGROK).

# --- Asaas (PIX_PROVIDER=ASAAS) --- API própria; sandbox: https://api-sandbox.asaas.com/v3
#PIX_ASAAS_URL=https://api.asaas.com/v3
#PIX_ASAAS_API_KEY=
#PIX_ASAAS_CLIENTE_ID=cus_000000000000
#PIX_ASAAS_EMAIL_WEBHOOK=loja@seudominio.com.br
# true = o meio PIX só vale com cobrança confirmada pelo provedor
#FRUTEIRA_PIX_OBRIGATORIO=false

# NCM: rotina diária (cron Quartz), obrigatoriedade no cartão/TEF
#NCM_CRON=0 0 3 * * ?
#FRUTEIRA_NCM_AGENDADO=true
#FRUTEIRA_NCM_NA_SUBIDA=true
#FRUTEIRA_NCM_OBRIGATORIO_TEF=true
#FRUTEIRA_NCM_OBRIGATORIO=false

# Caixa: saldo da gaveta (R$) a partir do qual o PDV recomenda sangria
#CAIXA_LIMITE_GAVETA=500

# ---------------- NFC-e / Nota Fiscal Gaúcha (SEFAZ-RS) ----------------
# simulador = NÃO vale fiscalmente (testes). sefaz = monta o XML (CPF em <dest>), assina com o certificado A1 e transmite à SEFAZ-RS por mTLS.
FISCAL_PROVIDER=simulador
# 2 = homologação (comece aqui) · 1 = produção
#FISCAL_AMBIENTE=2
#FISCAL_SERIE=1
#FISCAL_NUMERO_INICIAL=1
# Emitente (iguais ao cadastro na SEFAZ). Endereço completo é obrigatório. Confirme CFOP/CSOSN/CST com seu contador.
#FISCAL_CNPJ=12345678000195
#FISCAL_RAZAO=FRUTEIRA CONVENTOS LTDA
#FISCAL_FANTASIA=Fruteira Conventos
#FISCAL_IE=0170123456
#FISCAL_LOGRADOURO=RUA DAS FRUTAS
#FISCAL_NUMERO=100
#FISCAL_BAIRRO=CENTRO
#FISCAL_CMUN=4321105
#FISCAL_MUNICIPIO=CONVENTOS
#FISCAL_CEP=95865000
#FISCAL_CFOP=5102
#FISCAL_CSOSN=102
# Regime: 1 = Simples Nacional (CSOSN) · 3 = Lucro Presumido/Real (CST) · 2 = Simples com excesso de sublimite · 4 = MEI
#FISCAL_CRT=1
#FISCAL_IM=
#FISCAL_NATOP=VENDA DE MERCADORIA
# Padrão da loja para itens sem classificação própria (cada produto pode ter a sua em Produtos e preços → 🧾 Fiscal).
# CFOP de NFC-e = 5xxx. Simples: FISCAL_CSOSN 102/103/300/400/500. Regime normal: FISCAL_CST_ICMS 00/40/41/50/60 (00 exige FISCAL_ALIQ_ICMS).
# PIS/COFINS: 01/02 tributado (exige alíquota) · 04 a 09 não tributado · 49/99 outras. Hortifrúti in natura costuma ser isento/alíquota zero: confirme com o contador.
#FISCAL_ORIGEM=0
#FISCAL_CST_ICMS=40
#FISCAL_CST_PIS=07
#FISCAL_CST_COFINS=07
#FISCAL_ALIQ_ICMS=0
#FISCAL_ALIQ_PIS=0
#FISCAL_ALIQ_COFINS=0
# IBS/CBS (reforma tributária, NT 2025.002): auto = informa só no regime normal (CRT 3, obrigatório desde 03/08/2026); Simples/MEI: obrigatório só a partir de 04/01/2027.
# on/off forçam. Ligado, informe o CST (3 dígitos) e o cClassTrib (6 dígitos) da tabela oficial (padrão da loja aqui, ou por produto). Alíquotas de 2026 (teste): CBS 0,9% e IBS 0,1%.
#FISCAL_IBSCBS=auto
#FISCAL_IBSCBS_CST=
#FISCAL_IBSCBS_CCLASSTRIB=
#FISCAL_PIBS_UF=0.10
#FISCAL_PIBS_MUN=0
#FISCAL_PCBS=0.90
# Cartão só entra na nota com os dados do TEF (CNPJ da credenciadora, bandeira e autorização). Padrão: exige com FISCAL_PROVIDER=sefaz. false = aceita cartão de maquininha não integrada (tpIntegra 2).
#FISCAL_EXIGE_TEF=true
# CSC (Código de Segurança do Contribuinte) e seu ID — gerados no portal da SEFAZ-RS; entram no QR Code
#FISCAL_CSC_ID=1
#FISCAL_CSC=
# Certificado digital A1 (e-CNPJ, .pfx/.p12). A3 (token/cartão) não é lido por este emissor.
# Coloque o arquivo "certificado.pfx" NA RAIZ DO PROJETO (ao lado deste .env): é achado sozinho, sem FISCAL_CERT_PATH.
# FISCAL_CERT_PATH só se o arquivo tiver outro nome/lugar (caminho absoluto, ou relativo à raiz).
# O CNPJ do certificado precisa ser da mesma empresa do FISCAL_CNPJ (mesma raiz de 8 dígitos); certificado vencido bloqueia a emissão.
#FISCAL_CERT_PATH=./certificado.pfx
FISCAL_CERT_SENHA=
# Só se a SEFAZ-RS recusar o TLS (cadeia ICP-Brasil fora do cacerts do Java): truststore JKS/PKCS12 com a cadeia
#FISCAL_TRUST_PATH=
#FISCAL_TRUST_SENHA=
# Endereços (padrão do RS já embutido; sobrescreva se a SEFAZ mudar)
#FISCAL_URL_AUTORIZACAO=
#FISCAL_URL_STATUS=
#FISCAL_URL_CONSULTA=
#FISCAL_URL_EVENTO=
#FISCAL_URL_QR=https://www.sefaz.rs.gov.br/NFCE/NFCE-COM.aspx
#FISCAL_URL_CHAVE=www.sefaz.rs.gov.br/nfce/consulta

# --- NF-e (modelo 55) — venda a empresa que exige nota eletrônica; emissor separado da NFC-e ---
# Usa o mesmo certificado A1, emitente e ambiente da NFC-e (não exige CSC). Série própria.
#FISCAL_NFE_SERIE=1
#FISCAL_NFE_NUMERO_INICIAL=1
# URLs dos webservices da SEFAZ-RS para NF-e: CONFIRA no portal da SEFAZ antes de produção (padrão do sistema não foi validado).
#FISCAL_NFE_URL_AUTORIZACAO=
#FISCAL_NFE_URL_CONSULTA=
#FISCAL_NFE_URL_EVENTO=
#FISCAL_NFE_URL_STATUS=

# PIN do supervisor para aprovar sangria (só vale se a opção estiver ligada em Caixa). Vazio = usa o PIN do gerente.
SUPERVISOR_PIN=
