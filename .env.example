# ============================================================
#  Fruteira — configuração de ambiente (copie para .env)
#  Não use aspas nem espaços ao redor do "=".
# ============================================================
# desenvolvimento -> login local (usuário = senha = perfil), banco H2, sem Docker
# producao        -> login via Keycloak (OIDC), perfis validados no Quarkus, PostgreSQL (Docker)
APP_ENV=desenvolvimento

# ---------------- só em producao ----------------
# false (padrão) = produção LOCAL sem HTTPS: front via "vite preview" em http://localhost:5173
# true           = HTTPS real com nginx + domínios (preencha o bloco "nginx" abaixo)
USE_NGINX=false

# URLs públicas. Sem nginx: localhost. Com nginx: https://<domínios abaixo>, sem barra no final.
KEYCLOAK_URL=http://localhost:8180
FRONT_URL=http://localhost:5173

KEYCLOAK_REALM=fruteira
KEYCLOAK_WEB_CLIENT=pdv-web
KEYCLOAK_API_CLIENT=fruteira-api
KEYCLOAK_ADMIN=admin
KEYCLOAK_ADMIN_PASSWORD=troque-esta-senha
KEYCLOAK_DB_PASS=troque-esta-senha-tambem

# Validação do certificado do Keycloak pelos serviços Java: required | none (só teste com certificado autoassinado)
OIDC_TLS_VERIFICATION=required

# PostgreSQL da aplicação
DB_URL=jdbc:postgresql://localhost:5432/fruteira
DB_USER=postgres
DB_PASS=troque-a-senha-do-banco

# ---------------- bloco "nginx" (USE_NGINX=true) ----------------
# DNS dos dois domínios apontando para este servidor; então KEYCLOAK_URL=https://KEYCLOAK_DOMAIN e FRONT_URL=https://FRONT_DOMAIN
FRONT_DOMAIN=fruteira.exemplo.com.br
KEYCLOAK_DOMAIN=auth.exemplo.com.br
LE_EMAIL=admin@exemplo.com.br

# ---------------- TEF (agente local do caixa) ----------------
# simulador = NÃO cobra de verdade (testes). clisitef = a implementar com a DLL do seu provedor (ver tef-agent).
TEF_PROVIDER=simulador
# Token que o caixa envia ao agente; use o mesmo em Configurações → Balança e periféricos. Em produção, um valor longo e secreto.
#TEF_TOKEN=troque-por-um-token-longo
# Origens permitidas (CORS) para chamar o agente; por padrão usa FRONT_URL
#TEF_ORIGENS=https://loja.seudominio.com.br
# Exigir TEF para crédito/débito (variável lida pelo vendas-service): true | false
#FRUTEIRA_TEF_OBRIGATORIO=false
