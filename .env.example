# ============================================================
#  Fruteira — configuração de ambiente (copie para .env)
#  APP_ENV=desenvolvimento -> login local (usuário = senha = perfil), banco H2, sem Docker
#  APP_ENV=producao        -> login via Keycloak (OIDC), perfis validados no Quarkus, PostgreSQL
#  Não use aspas nem espaços ao redor do "=".
# ============================================================
APP_ENV=desenvolvimento

# ---------- usados somente em producao ----------
# Domínios públicos (DNS apontando para este servidor) — TROQUE pelos reais
FRONT_DOMAIN=fruteira.exemplo.com.br
KEYCLOAK_DOMAIN=auth.exemplo.com.br
# E-mail para o Let's Encrypt (avisos de expiração)
LE_EMAIL=admin@exemplo.com.br
# Keycloak (KEYCLOAK_URL deve ser https://KEYCLOAK_DOMAIN)
KEYCLOAK_URL=https://auth.exemplo.com.br
KEYCLOAK_REALM=fruteira
KEYCLOAK_WEB_CLIENT=pdv-web
KEYCLOAK_API_CLIENT=fruteira-api
KEYCLOAK_ADMIN=admin
KEYCLOAK_ADMIN_PASSWORD=troque-esta-senha
KEYCLOAK_DB_PASS=troque-esta-senha-tambem
# URL pública do front (CORS)
FRONT_URL=https://fruteira.exemplo.com.br   # deve ser https://FRONT_DOMAIN
# Validação do certificado do Keycloak pelos serviços Java: required (certificado real) | none (somente teste com certificado autoassinado)
OIDC_TLS_VERIFICATION=required
# PostgreSQL da aplicação
DB_URL=jdbc:postgresql://localhost:5432/fruteira
DB_USER=postgres
DB_PASS=troque-a-senha-do-banco
