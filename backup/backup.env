# Configuração do backup (sem aspas). Pode ser sobrescrita por variáveis de ambiente ou pela linha de comando.

# Onde o backup é gravado no próprio computador (padrão: backup/saida)
#BACKUP_PASTA=

# Cópias EXTRAS, separadas por ponto e vírgula:
#   pendrive no Windows:   E:\fruteira
#   pendrive no Linux:     /media/usuario/PENDRIVE/fruteira
#   Google Drive (app "Drive para computador" instalado): G:\Meu Drive\Fruteira
#BACKUP_DESTINOS=E:\fruteira;G:\Meu Drive\Fruteira

# Senha de criptografia (AES-256). RECOMENDADO: o backup contém o .env, o certificado digital e os dados dos clientes.
# GUARDE ESTA SENHA em outro lugar: sem ela o backup não abre.
#BACKUP_SENHA=

# Quantos dias manter (apaga os mais antigos, na pasta local e nos destinos). 0 = nunca apagar
BACKUP_RETENCAO_DIAS=30

# Google Drive SEM o app de computador: instale o rclone, rode "rclone config" e crie um remoto (ex.: gdrive)
#RCLONE_DESTINO=gdrive:Fruteira/backup
